  m_text: "\uB2F9\uC2E0\uC740 \uC0AC\uC0C1\uACBD\uCC30\uC758 \uAC10\uC2DC\uB97C \uB6AB\uACE0
    \uB9C8\uCE68\uB0B4 \uB300\uC7A5\uC774 \uC9C0\uC815\uD55C \uC7A5\uC18C\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.\L
