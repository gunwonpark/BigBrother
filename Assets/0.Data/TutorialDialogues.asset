  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1e61571268a4af46927e642eb93a0a6, type: 3}
  m_Name: TutorialDialogues
  m_EditorClassIdentifier: 
  dialogues:
  - groupIndex: 0
    dialogues:
    - "\uB2F9\uC2E0\uC740 \uC0AC\uC0C1\uACBD\uCC30\uC758 \uAC10\uC2DC\uB97C \uB6AB\uACE0
      \uB9C8\uCE68\uB0B4 \uB300\uC7A5\uC774\\n\uC9C0\uC815\uD55C \uC7A5\uC18C\uC5D0
      \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4."
    - "\uADF8\uB7EC\uB098 \uC774\uACF3\uC870\uCC28 \uC548\uC804\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. "
    - "\uC5B8\uC81C\uB4E0 \uC0AC\uC0C1\uACBD\uCC30\uC774 \uB098\uD0C0\uB0A0 \uC218
      \uC788\uC73C\uB2C8 \uC8FC\uC758\uD574\uC57C \uD569\uB2C8\uB2E4."
    - "\uB2F9\uC2E0\uC758 \uBAA9\uD45C\uB294 \uB300\uC7A5\uC774 \uB0A8\uAE34 \uC554\uD638\uB97C
      \uD574\uB3C5\uD558\uB294 \uAC83."
    - "\uADF8 \uACFC\uC815\uC740 \uC27D\uC9C0 \uC54A\uC9C0\uB9CC \uC81C\uAC00 \uB3C4\uC640\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4. "
    - "\uC9D1\uC911\uD574\uC11C \uB530\uB77C\uC624\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
  - groupIndex: 1
    dialogues:
    - "\uD480\uC5B4\uC57C \uD560 \uC554\uD638\uB294 \uC774\uACF3\uC5D0\uC11C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - groupIndex: 1
    dialogues:
    - "\uC88C\uC6B0\uB85C \uB4DC\uB798\uADF8\uD558\uBA70 \uC554\uD638 \uC804\uCCB4\uB97C
      \uC0B4\uD3B4\uBCF4\uC138\uC694."
    - "\uC554\uD638\uC758 \uC2DC\uC791\uACFC \uB05D\uC740 \uC774\uC5B4\uC838 \uC788\uC73C\uB2C8,
      \uB05D\uAE4C\uC9C0 \uD0D0\uC0C9\uD574\uB3C4 \uCC98\uC74C\uC73C\uB85C \uB3CC\uC544\uC635\uB2C8\uB2E4."
  - groupIndex: 1
    dialogues:
    - "\uB2F9\uC2E0\uC758 \uC784\uBB34\uB294 \uB300\uC7A5\uC774 \uB0A8\uAE34 \uC9C4\uC9DC
      \uC554\uD638\uB9CC \uB0A8\uAE30\uACE0 \uB098\uBA38\uC9C0\uB294 \uBAA8\uB450
      \uC0AD\uC81C\uD558\uB294 \uAC83\uC785\uB2C8\uB2E4."
    - "\uC6B0\uD074\uB9AD\uC73C\uB85C \uC554\uD638\uC5D0 \uB300\uD55C \uD78C\uD2B8\uB97C
      \uC5BB\uC744 \uC218 \uC788\uACE0 "
  - groupIndex: 1
    dialogues:
    - "\uC88C\uD074\uB9AD\uC73C\uB85C \uAE00\uC790\uB97C \uC9C0\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\_"
  - groupIndex: 1
    dialogues:
    - "\uADDC\uCE59\uC5D0 \uB300\uD55C \uB0B4\uC6A9\uC740 \uC81C\uAC00 \uBA54\uBAA8\uC7A5\uC73C\uB85C
      \uB0A8\uACA8 \uB450\uC5C8\uC2B5\uB2C8\uB2E4. "
    - "\uBC18\uB4DC\uC2DC \uCC38\uACE0\uD558\uB3C4\uB85D \uD558\uC138\uC694."
  - groupIndex: 1
    dialogues:
    - "\uADF8\uB7FC... \uAF2D #@$@#$!!$%#^@#^$%@#$\uD558\uAE38 :)"
